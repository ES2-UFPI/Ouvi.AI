# Valores de desenvolvimento local. Para copiar: cp .env.example .env
# Troque à vontade, mas evite caracteres especiais (@ : / #) na senha do banco,
# pois ela entra na URL de conexão da API.

# PostgreSQL
POSTGRES_USER=ouveai
POSTGRES_PASSWORD=ouveai
POSTGRES_DB=ouveai

# MinIO (console em http://localhost:9001)
MINIO_ROOT_USER=ouveai
MINIO_ROOT_PASSWORD=ouveai123
