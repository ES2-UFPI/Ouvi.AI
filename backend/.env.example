# Copie para backend/.env e ajuste: cp backend/.env.example backend/.env
# Valores abaixo são apenas para desenvolvimento local.

# Fora do Docker use localhost. Dentro do docker compose o host (db) é definido no docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://ouveai:ouveai@localhost:5432/ouveai

# Troque por um valor aleatório (ex.: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=change-me

MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=ouveai
MINIO_ROOT_PASSWORD=ouveai123
