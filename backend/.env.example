# Valores de desenvolvimento local. Para copiar: cp backend/.env.example backend/.env
# Este arquivo é usado pela API. As credenciais do Postgres e do MinIO dos containers
# ficam no .env da raiz do projeto.

# Dentro do docker compose a API usa o host `db` (definido no docker-compose.yml, a partir do .env da raiz).
# Este valor com `localhost` só vale para rodar a API fora do Docker.
DATABASE_URL=postgresql+psycopg2://ouveai:ouveai@localhost:5432/ouveai

# Troque por um valor aleatório: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

# Segredo das URLs assinadas do áudio. Gere como o JWT_SECRET, mas com outro valor.
AUDIO_SIGNING_SECRET=change-me-audio
# Validade, em segundos, da URL que o player usa
AUDIO_URL_TTL_SECONDS=3600

# Origens do front-end autorizadas a chamar a API (separadas por vírgula)


CORS_ORIGINS=http://localhost:5173

# "development" cria o bucket sozinho na subida da API. Em produção use "production".
APP_ENV=development

# Armazenamento de objetos compatível com S3: "s3" (MinIO em dev, Cloudflare R2 em produção) ou "memory"
STORAGE_BACKEND=s3
# Endpoint que a API usa. Dentro do docker compose ele vira http://minio:9000 automaticamente.
STORAGE_ENDPOINT=http://localhost:9000
# Endpoint que o NAVEGADOR usa nas URLs assinadas do player. Vazio = o mesmo do STORAGE_ENDPOINT.
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
# No MinIO de dev são o usuário e a senha do .env da raiz (MINIO_ROOT_USER/MINIO_ROOT_PASSWORD)
STORAGE_ACCESS_KEY=ouveai
STORAGE_SECRET_KEY=ouveai123
STORAGE_BUCKET=ouveai-audio
# MinIO aceita qualquer região; no Cloudflare R2 use "auto"
STORAGE_REGION=us-east-1

# Provedor de TTS (síntese de voz): "fake" gera tons audíveis, sem rede nem chave (padrão, serve para desenvolver
# e testar); "azure" usa a voz real do Azure Speech (veja a seção "TTS real (Azure Speech)" do README).
TTS_PROVIDER=fake
# Chave e região do fornecedor real (o provedor falso ignora). Nunca coloque a chave no repositório.
# No Azure: portal > recurso Speech > "Chaves e ponto de extremidade" (Chave 1 e Região, ex.: brazilsouth)
TTS_API_KEY=
TTS_REGION=
# Voz usada na síntese (o provedor falso ignora). Com "azure", use uma voz multilíngue, que fala os dois
# idiomas com o mesmo timbre: pt-BR-ThalitaMultilingualNeural, en-US-AvaMultilingualNeural ou
# en-US-AndrewMultilingualNeural. Trocar a voz é só mudar esta linha.
TTS_VOICE_ID=fake-voice
# Voz por IDIOMA BASE do filtro (a que narra a frase). Opcionais: vazio = usa a TTS_VOICE_ID acima.
# Ex.: Cenário A/C (base português) com a Thalita e Cenário B (base inglês) com a Ava.
TTS_VOICE_ID_PT=
TTS_VOICE_ID_EN=
